# Bot token from @BotFather (TELEGRAM__TOKEN works too)
TOKEN="telegram-bot-token"
# Comma separated chat IDs allowed to use the bot. Leave empty and message
# the bot once: it replies with your chat ID.
WHITELISTED_IDS=""
# Optional: database for sessions (default: ./dockeroller.db, SQLite)
# DB__DSN="postgres://user:pass@localhost:5432/dockeroller?sslmode=disable"
